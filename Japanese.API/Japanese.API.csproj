    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5b6bbcb5-d7c3-4310-9fb5-8905eb0f2ceb</UserSecretsId>
    <DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controllers\CommonWordController.cs" />
    <Compile Remove="Controllers\HiraganaController.cs" />
