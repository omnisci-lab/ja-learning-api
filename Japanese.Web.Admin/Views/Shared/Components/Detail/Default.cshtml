@model Dictionary<string, object>

<div class="card">
    <div class="card-header">
        Details: 
    </div>
    <div class="card-body">
        <dl class="row">
            @foreach (KeyValuePair<string, object> pair in Model){
                <dt class="col-sm-2">
                    @pair.Key
                </dt>
                <dd class="col-sm-10">
                    @pair.Value
                </dd>
            }
        </dl>
    </div>
    <div class="card-footer">
        <div class="d-flex justify-content-center">
            <a class="btn btn-success btn-sm m-1" href="@ViewData["ListUrl"]">Back to List</a>
            <a class="btn btn-primary btn-sm m-1" href="@ViewData["EditUrl"]">Edit</a>
            <button class="btn btn-danger btn-sm m-1" form="deleteSentence">Delete</button>
            <form action="@ViewData["DeleteUrl"]" id="deleteSentence">
                <input type="hidden" name="SentenceId" value="1" />
            </form>
        </div>
    </div>
</div>