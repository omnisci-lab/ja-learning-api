@model Japanese.Services.Features.Sentence.Commands.CreateSentence.CreateSentenceCommand

@await Component.InvokeAsync("Notif")

<div class="card">
    <div class="card-header">
        Create
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <form asp-action="Create" id="createSentence">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="Text" class="control-label"></label>
                        <input asp-for="Text" class="form-control" />
                        <span asp-validation-for="Text" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="EnMeanings" class="control-label"></label>
                        <input asp-for="EnMeanings" class="form-control" />
                        <span asp-validation-for="EnMeanings" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ViMeanings" class="control-label"></label>
                        <input asp-for="ViMeanings" class="form-control" />
                        <span asp-validation-for="ViMeanings" class="text-danger"></span>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <div class="d-flex justify-content-between">
            <div class="btn-group">
                <a class="btn btn-dark btn-sm m-1" asp-action="Index">Back to List</a>
            </div>
            <div class="btn-group">
                <button class="btn btn-success btn-sm m-1" form="createSentence">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
