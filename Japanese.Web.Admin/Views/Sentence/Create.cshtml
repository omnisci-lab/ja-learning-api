@using Japanese.Services.Features.Sentence.Commands.CreateSentence;
@model CreateSentenceCommand

@await Component.InvokeAsync("Notif")

@await Component.InvokeAsync("DynamicCreateView", new {
    type = typeof(CreateSentenceCommand),
    data = Model,
    metadataType = typeof(SentenceMetadata.CreateSentenceCommand),
    formUrl = new UrlInfo { ActionName = "Create", ControllerName = "Sentence" },
    listUrl = new UrlInfo { ActionName = "Index", ControllerName = "Sentence" }
})

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}