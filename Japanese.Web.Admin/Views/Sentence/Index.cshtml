@using Japanese.Services.Sentence.Consts
@using Japanese.Services.Sentence.Queries.GetPagedSentences;
@using Japanese.Services.Sentence.Queries;
@model PagedResult<SentenceOutput>

@await Component.InvokeAsync("Notif")

@{
    List<int> pageSizes = new List<int> { 20, 50, 100, 200 };
}

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between">
            <div>
                <p class="m-0">List of Sentences</p>
            </div>
            <div class="align-middle">
                <a class="btn btn-success btn-sm" asp-action="Create">Create</a>
            </div>
        </div>

        <div class="d-flex justify-content-center border-top mt-1">
            <form asp-action="Index" method="get">
                <div class="row">
                    <div class="col">
                        <label>Records/page</label>
                        <select name="PageSize" class="form-control" style="width: 100px;" onchange="this.form.submit();">
                            @foreach (int pageSize in pageSizes)
                            {
                                if (pageSize == Model.PageSize)
                                {
                                    <option value="@pageSize" selected>@pageSize</option>
                                }
                                else
                                {
                                    <option value="@pageSize">@pageSize</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col">
                        <label>Search by</label>
                        @{
                            FieldInfo[] fields = typeof(SentenceConsts).GetFields();
                        }
                        <select name="SearchBy" class="form-control" style="width: 100px;">
                            @foreach(FieldInfo field in fields){
                                if (Model.SearchBy == field.GetRawConstantValue()?.ToString()){
                                    <option value="@field.GetRawConstantValue()" selected>@field.Name</option>
                                }
                                else
                                {
                                    <option value="@field.GetRawConstantValue()">@field.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col">
                        <label>Search</label>
                        <input type="text" class="form-control" name="Keyword" value="@Model.Keyword" style="width: 150px;" />
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="card-body">
        @await Component.InvokeAsync("DynamicTable", new {
            type = typeof(SentenceOutput),
            metadataType = typeof(SentenceMetadata.SentenceOutput),
            data = Model.Items!.ToArray(),
            detailUrl = new UrlInfo {
                ActionName = "GetDetails",
                ControllerName = "Sentence",
                RouteValues = new List<RouteValueObject>{
                    new RouteValueObject { RouteProperty = "sentenceId", MapToProperty = "SentenceId" }
                }
            }
        })
    </div>
    <div class="card-footer">
        <div class="d-flex justify-content-center">
            <form asp-action="Index" method="get">
                <input type="hidden" asp-for="PageSize" />
                <input type="hidden" asp-for="SearchBy" />
                <input type="hidden" asp-for="PaginationToken" />
                <button class="btn btn-link">Next page</button>
            </form>
        </div>
    </div>
</div>