@using Japanese.Services.Features.Sentence.Queries.GetPagedSentences;
@using Japanese.Services.Features.Sentence.Queries;
@model Pagination<SentenceOutput>

@await Component.InvokeAsync("Notif")

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between">
            <div>
                <p class="m-0">List of Sentences</p>
            </div>
            <div>
                <form asp-action="Index" method="get">
                    <label>Số bản ghi/trang:</label>
                    <select name="PageSize" class="form-control" style="display: inline; width: 50px;">
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                    </select>
                    <input type="text" />
                </form>
            </div>
            <div>
                <a class="btn btn-success btn-sm" asp-action="Create">Create</a>
            </div>
            
        </div>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Text</th>
                    <th scope="col">En Meanings</th>
                    <th scope="col">Vi Meanings</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int count = 1;
                }
                @foreach (SentenceOutput sentence in Model.Items!)
                {
                    <tr ondblclick="location.href = '@Url.Action("GetDetails", new { sentenceId = sentence.SentenceId })'">
                        <th scope="row">@count</th>
                        <td>@sentence.Text</td>
                        <td>@sentence.EnMeanings</td>
                        <td>@sentence.ViMeanings</td>
                    </tr>
                    count++;
                }
            </tbody>
        </table>

    </div>
    <div class="card-footer">
        <div class="d-flex justify-content-center">
            <a class="text-center" asp-action="Index" asp-route-PaginationToken="@Model.PaginationToken">Trang tiếp theo</a>
        </div>
    </div>
</div>
