@using Japanese.Services.Features.Sentence.Queries
@model SentenceOutput

@await Component.InvokeAsync("DynamicDetailView", new {
    type = typeof(SentenceOutput),
    metadataType = typeof(SentenceOutputMetadata),
    data = Model,
    listUrl = new UrlInfo{
        ActionName = "Index",
        ControllerName = "Sentence"
    },
    editUrl = new UrlInfo{
        ActionName = "Edit",
        ControllerName = "Sentence",
        RouteValues = new List<RouteValueObject> {
            new RouteValueObject{ RouteProperty = "sentenceId", MapToProperty = "SentenceId" }
        }
    },
    deletionForm = new DynamicForm {
        ActionName = "Delete",
        ControllerName = "Sentence",
        FormFields = new List<DynamicFormField> {
            new DynamicFormField { Name = "SentenceId", MapToProperty = "SentenceId" }
        }
    }
});