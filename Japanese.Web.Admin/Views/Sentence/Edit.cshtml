@using Japanese.Services.Features.Sentence.Commands.UpdateSentence
@model UpdateSentenceCommand

@await Component.InvokeAsync("Notif")

@await Component.InvokeAsync("DynamicUpdateView", new {
    type = typeof(UpdateSentenceCommand),
    metadataType = typeof(SentenceMetadata.UpdateSentenceCommand),
    data = Model,
    formUrl = new UrlInfo { ActionName = "Edit", ControllerName = "Sentence" },
    listUrl = new UrlInfo { ActionName = "Index", ControllerName = "Sentence" },
    detailUrl = new UrlInfo { 
        ActionName = "GetDetails", 
        ControllerName = "Sentence",
        RouteValues = new List<RouteValueObject> {
            new RouteValueObject { RouteProperty = "sentenceId", MapToProperty = nameof(UpdateSentenceCommand.SentenceId) }
        }
    },
    deletionForm = new DynamicForm { 
        ActionName = "Delete", 
        ControllerName = "Sentence",
        FormFields = new List<DynamicFormField>{
            new DynamicFormField { Name = "SentenceId", MapToProperty = "SentenceId" }
        }
    }
});

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}