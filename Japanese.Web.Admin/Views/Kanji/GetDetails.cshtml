@using Japanese.Services.Kanji.Queries
@model KanjiDetailOutput

@await Component.InvokeAsync("DynamicDetailView", new {
    type = typeof(KanjiDetailOutput),
    metadataType = typeof(KanjiMetadata.KanjiDetailOutput),
    data = Model,
    listUrl = new UrlInfo{
        ActionName = "Index",
        ControllerName = "Kanji"
    },
    editUrl = new UrlInfo{
        ActionName = "Edit",
        ControllerName = "Kanji",
        RouteValues = new List<RouteValueObject> {
            new RouteValueObject{ RouteProperty = "kanji", MapToProperty = "Kanji" }
        }
    },
    deletionForm = new DynamicForm {
        ActionName = "Delete",
        ControllerName = "Kanji",
        FormFields = new List<DynamicFormField> {
            new DynamicFormField { Name = "kanji", MapToProperty = "Kanji" }
        }
    }
});