@using Japanese.Services.Kanji.Commands.CreateKanji
@model CreateKanjiCommand

@await Component.InvokeAsync("Notif")

@await Component.InvokeAsync("DynamicCreateView", new {
    type = typeof(CreateKanjiCommand),
    data = Model,
    metadataType = typeof(KanjiMetadata.CreateKanjiCommand),
    formUrl = new UrlInfo { ActionName = "Create", ControllerName = "Kanji" },
    listUrl = new UrlInfo { ActionName = "Index", ControllerName = "Kanji" }
})

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}